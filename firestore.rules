rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Doctors collection - allow public read/write for development
    // TODO: Restrict write access in production!
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Users collection - users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reviews collection - public read, authenticated write
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (resource.data.patientId == request.auth.uid || 
         request.auth.token.role == 'admin');
    }
    
    // Clinics collection - public read, authenticated write
    match /clinics/{clinicId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Doctor Verification Requests collection
    match /verification_requests/{requestId} {
      // Doctors can create their own requests and read their own
      allow create: if request.auth != null &&
        request.auth.token.role == 'doctor' &&
        request.auth.uid == resource.data.doctorId;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.doctorId || // Doctor can read their own
        request.auth.token.role == 'admin' // Admins can read all
      );
      allow update: if request.auth != null &&
        request.auth.token.role == 'admin'; // Only admins can update (approve/deny)
      allow delete: if request.auth != null &&
        request.auth.token.role == 'admin'; // Only admins can delete
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
