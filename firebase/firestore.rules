rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // Open Healthcare Personnel Data collection - public read, admin-only write
    match /open_healthcare_personnel_data/{openDataId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Open Medical Facility Data collection - public read, admin-only write
    match /open_medical_facility_data/{openDataId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Open Agency Data collection - public read, admin-only write
    match /open_agency_data/{openDataId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) || isAdmin()) &&
        // Protect role transitions
        (request.resource.data.role == resource.data.role || 
         (resource.data.role == null && request.resource.data.role in ['patient', 'healthcare_personnel', 'medical_facility', 'agency']) ||
         isAdmin()) &&
        // Protect admin-controlled IDs
        (!request.resource.data.keys().hasAny(['personalHealthcarePersonnelData']) ||
         !request.resource.data.personalHealthcarePersonnelData.keys().hasAny(['openHealthcarePersonnelDataId']) ||
         request.resource.data.personalHealthcarePersonnelData.openHealthcarePersonnelDataId == resource.data.get('personalHealthcarePersonnelData', {}).get('openHealthcarePersonnelDataId', null) ||
         isAdmin()) &&
        (!request.resource.data.keys().hasAny(['personalMedicalFacilityData']) ||
         !request.resource.data.personalMedicalFacilityData.keys().hasAny(['openMedicalFacilityDataId']) ||
         request.resource.data.personalMedicalFacilityData.openMedicalFacilityDataId == resource.data.get('personalMedicalFacilityData', {}).get('openMedicalFacilityDataId', null) ||
         isAdmin()) &&
        (!request.resource.data.keys().hasAny(['personalAgencyData']) ||
         !request.resource.data.personalAgencyData.keys().hasAny(['openAgencyDataId']) ||
         request.resource.data.personalAgencyData.openAgencyDataId == resource.data.get('personalAgencyData', {}).get('openAgencyDataId', null) ||
         isAdmin());
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Support Tickets collection
    match /support_tickets/{ticketId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && 
         resource.data.status in ['open', 'in_progress'] &&
         request.resource.data.assignedTo == resource.data.get('assignedTo', null)) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Treatment Plans collection
    match /treatment_plans/{planId} {
      function personnelHasMatchingTags() {
        let userDoc = getUserData();
        let personnelTags = userDoc.personalHealthcarePersonnelData.get('procedureTags', []);
        let planTags = resource.data.procedureTags;
        return personnelTags.hasAny(planTags);
      }
      
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (hasRole('healthcare_personnel') && personnelHasMatchingTags())
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (hasRole('healthcare_personnel') && personnelHasMatchingTags())
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
