rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Doctors collection - public read, admin-only write
    match /doctors/{doctorId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users collection - users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reviews collection - public read, authenticated write
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (resource.data.patientId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Clinics collection - public read, authenticated write
    match /clinics/{clinicId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Doctor Verification Requests collection
    match /verification_requests/{requestId} {
      // Doctors can create their own requests and read their own
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor' &&
        request.auth.uid == request.resource.data.doctorId;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.doctorId || // Doctor can read their own
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' // Admins can read all
      );
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; // Only admins can update (approve/deny)
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; // Only admins can delete
    }

    // Support Tickets collection
    match /support_tickets/{ticketId} {
      // Authenticated users can create tickets
      allow create: if request.auth != null;
      
      // Users can read their own tickets, admins can read all
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      // Users can update their own open/in_progress tickets (add messages)
      // Admins can update any ticket
      allow update: if request.auth != null && (
        (resource.data.userId == request.auth.uid && 
         resource.data.status in ['open', 'in_progress']) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      // Only admins can delete tickets
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Treatment Plans collection
    match /treatment_plans/{planId} {
      // Helper function to check if doctor has matching procedure tags
      function doctorHasMatchingTags() {
        let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        let doctorTags = userDoc.data.doctorInfo.procedureTags;
        let planTags = resource.data.procedureTags;
        // Check if any doctor tag matches any plan tag
        return doctorTags.hasAny(planTags);
      }
      
      // Authenticated users can create treatment plans
      allow create: if request.auth != null;
      
      // Users can read their own plans
      // Doctors can read plans with matching procedure tags
      // Admins can read all plans
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor' && 
         doctorHasMatchingTags())
      );
      
      // Users can update their own plans
      // Doctors with matching tags can add responses
      // Admins can update any
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor' && 
         doctorHasMatchingTags())
      );
      
      // Only users and admins can delete their own plans
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
