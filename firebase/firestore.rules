rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open Healthcare Personnel Data collection - public read, admin-only write
    match /open_healthcare_personnel_data/{openDataId} {
      allow read: if true; // Public read for healthcare personnel search
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Open Medical Facility Data collection - public read, admin-only write
    match /open_medical_facility_data/{openDataId} {
      allow read: if true; // Public read for medical facility search
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Open Agency Data collection - public read, admin-only write
    match /open_agency_data/{openDataId} {
      allow read: if true; // Public read for agency search
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users collection - users can access their own data, but links are admin-controlled
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      // Users can create their own profile during signup
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Users can update their own profile or admins can update any profile
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      ) &&
        // Allow changing role from null to a valid role during signup, or keep role unchanged (unless admin)
        (request.resource.data.role == resource.data.role || 
         (resource.data.role == null && request.resource.data.role in ['patient', 'healthcare_personnel', 'medical_facility', 'agency']) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') &&
        // Healthcare personnel cannot edit their openHealthcarePersonnelDataId link (unless admin)
        (!request.resource.data.keys().hasAny(['personalHealthcarePersonnelData']) ||
         !request.resource.data.personalHealthcarePersonnelData.keys().hasAny(['openHealthcarePersonnelDataId']) ||
         request.resource.data.personalHealthcarePersonnelData.openHealthcarePersonnelDataId == resource.data.get('personalHealthcarePersonnelData', {}).get('openHealthcarePersonnelDataId', null) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') &&
        // Medical facilities cannot edit their openMedicalFacilityDataId link (unless admin)
        (!request.resource.data.keys().hasAny(['personalMedicalFacilityData']) ||
         !request.resource.data.personalMedicalFacilityData.keys().hasAny(['openMedicalFacilityDataId']) ||
         request.resource.data.personalMedicalFacilityData.openMedicalFacilityDataId == resource.data.get('personalMedicalFacilityData', {}).get('openMedicalFacilityDataId', null) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') &&
        // Agencies cannot edit their openAgencyDataId link (unless admin)
        (!request.resource.data.keys().hasAny(['personalAgencyData']) ||
         !request.resource.data.personalAgencyData.keys().hasAny(['openAgencyDataId']) ||
         request.resource.data.personalAgencyData.openAgencyDataId == resource.data.get('personalAgencyData', {}).get('openAgencyDataId', null) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Reviews collection - public read, authenticated write
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Support Tickets collection
    match /support_tickets/{ticketId} {
      // Authenticated users can create tickets
      allow create: if request.auth != null;
      
      // Users can read their own tickets, admins can read all
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      // Users can update their own open/in_progress tickets (add messages)
      // Admins can update any ticket
      allow update: if request.auth != null && (
        (resource.data.userId == request.auth.uid && 
         resource.data.status in ['open', 'in_progress']) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      // Only admins can delete tickets
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Treatment Plans collection
    match /treatment_plans/{planId} {
      // Helper function to check if healthcare personnel has matching procedure tags
      function personnelHasMatchingTags() {
        let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        let personnelTags = userDoc.data.personalHealthcarePersonnelData.procedureTags;
        let planTags = resource.data.procedureTags;
        // Check if any personnel tag matches any plan tag
        return personnelTags.hasAny(planTags);
      }
      
      // Authenticated users can create treatment plans
      allow create: if request.auth != null;
      
      // Users can read their own plans
      // Healthcare personnel can read plans with matching procedure tags
      // Admins can read all plans
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'healthcare_personnel' && 
         personnelHasMatchingTags())
      );
      
      // Users can update their own plans
      // Healthcare personnel with matching tags can add responses
      // Admins can update any
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'healthcare_personnel' && 
         personnelHasMatchingTags())
      );
      
      // Only users and admins can delete their own plans
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
