# Copy this file to .env.local and fill in your own values:
#   cp .env.example .env.local
# Never put real credentials in this file.

# --- Supabase ------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key — safe for the browser, protected by RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_publishable_key_here
# Server-side only key (never NEXT_PUBLIC_*, never sent to the browser)
SUPABASE_SECRET_KEY=your_server_side_key_here

# --- Cloudflare R2 (image uploads) ---------------------------
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=medikal-storage
# Public read URL (r2.dev subdomain or custom domain) — NOT the S3 endpoint
#   https://<account-id>.r2.cloudflarestorage.com is the S3 API, not this
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-bucket.r2.dev

# --- Admin / optional features -------------------------------
# Comma-separated list of admin account emails
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# --- Logging -------------------------------------------------
# debug | info | warn | error
NEXT_PUBLIC_LOG_LEVEL=info
# Enable specific debug namespaces, e.g. DEBUG=medikal:auth,medikal:r2
DEBUG=
# Server-side log level (optional; falls back to NEXT_PUBLIC_LOG_LEVEL)
LOG_LEVEL=info
# Enable verbose log.debug() output
DEBUG_VERBOSE=false
